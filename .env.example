# Free-first local application configuration.
# Copy to .env.local and replace every placeholder. Never commit real values.

NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://app_runtime:runtime_local_only@127.0.0.1:5432/email_product
DATABASE_WORKER_URL=postgresql://app_worker:worker_local_only@127.0.0.1:5432/email_product
DATABASE_MIGRATION_URL=postgresql://app_migration:migration_local_only@127.0.0.1:5432/email_product
AUTH_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LOG_LEVEL=info

# External delivery remains disabled until a later approved provider phase.
EMAIL_DELIVERY_MODE=disabled
EMAIL_CAPTURE_DIR=.local/email-captures
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=.local/storage

# Local/manual subscriptions only; no card collection.
BILLING_PROVIDER=local
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=25

# One-time local bootstrap value. Remove after granting the platform-owner role.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
