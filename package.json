{
  "name": "email-sender",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/check-database.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "smoke:capture:enqueue": "tsx scripts/enqueue-capture-smoke.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.0.4",
    "better-auth": "^1.7.14",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.414.0",
    "next": "16.4.3",
    "pino": "^10.1.0",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.4.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "27.4.0",
    "pino-pretty": "^13.1.1",
    "postcss": "^8",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "tsx": {
      "esbuild": "0.28.2"
    }
  }
}
