# SMTP Configuration
# Copy this file to .env.local (for Next.js) and fill in your values.
# NEVER commit .env.local to git.

# ── Gmail Setup ─────────────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: myaccount.google.com/apppasswords
# 3. Create an App Password (select "Mail" + device)
# 4. Use that 16-char password as SMTP_PASS below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Sender display name shown to recipients
FROM_NAME=Your Name or Company

# ── Other providers ──────────────────────────────────────────────────────────
# Outlook / Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587

# Yahoo Mail:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587

# SendGrid (more reliable for bulk):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASS=your-mailgun-password
